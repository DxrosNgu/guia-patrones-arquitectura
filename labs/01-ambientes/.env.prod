# Ambiente PROD: configuración NO secreta (este archivo SÍ se versiona).
# Los secretos van como archivos en secrets/ (ver compose.prod.yaml).

APP_VERSION=1.0.0
APP_ENV=prod
LOG_LEVEL=INFO
LOG_JSON=true
# El feature flag aún no se libera en prod: se está probando en dev.
FEATURED_ENABLED=false
SWAGGER_ENABLED=false

# CORS (demostración): la API pública del catálogo y quién puede leerla desde un navegador.
PUBLIC_API_URL=http://localhost:8201
CORS_ORIGINS=http://localhost:3200
