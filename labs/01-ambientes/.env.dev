# Ambiente DEV: configuración NO secreta (este archivo SÍ se versiona).
# Los secretos (DB_PASSWORD, SUPPLIER_API_KEY) NO van aquí: los pasa quien
# despliega como variables de entorno. Ver compose.dev.yaml.

APP_VERSION=1.0.0
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true
FEATURED_ENABLED=true
SWAGGER_ENABLED=true
