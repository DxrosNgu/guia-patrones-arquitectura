# Ambiente LOCAL. Copia este archivo a .env si quieres cambiar algún valor:
#   cp .env.example .env
# Si no existe .env, Compose usa los valores por defecto de compose.yaml,
# que son exactamente estos.

APP_VERSION=1.0.0
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
FEATURED_ENABLED=true
SWAGGER_ENABLED=true

# Secretos FALSOS, solo para local. Nunca pongas un secreto real en un .env
# que se pueda subir a Git (.env está en .gitignore; .env.example no).
DB_PASSWORD=catalog
SUPPLIER_API_KEY=sk-local-fake-0000
